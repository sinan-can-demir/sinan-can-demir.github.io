---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="Blog" description="Writing about open source, software engineering, security, and personal growth.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <header class="mb-12">
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50 mb-3">Blog</h1>
      <p class="text-zinc-500 dark:text-zinc-400">
        Writing about open source, software engineering, security, and personal growth.
      </p>
      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {allTags.map((tag) => (
            <span class="text-xs font-mono px-2 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    {posts.length === 0 ? (
      <p class="text-zinc-400 dark:text-zinc-500">No posts yet. Check back soon.</p>
    ) : (
      <div class="flex flex-col gap-4">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </section>
</BaseLayout>
